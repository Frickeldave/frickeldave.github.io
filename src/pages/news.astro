---
import BaseLayout from "@components/base/BaseLayout.astro";
import PageHeader from "@components/common/PageHeader.astro";
import NewsSidebar from "@components/news/Sidebar.astro";
import { FaRegCalendarAlt } from "react-icons/fa";

// News-Daten importieren
import newsDataRaw from "../../public/data/news.json";
import placeholderNewsImage from "@/assets/placeholder-news.png";
import { Image, type ImageMetadata } from "astro:assets";

const newsImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/news/*.{jpeg,jpg,png,gif}",
  { eager: true }
);

type NewsItem = {
  visible: boolean;
  date: string;
  title: string;
  text: string;
  imageUrl: string;
};

type NewsData = {
  news: NewsItem[];
};

const newsData = newsDataRaw as NewsData;

// Sichtbare News filtern und nach Datum sortieren
const visibleNews = newsData.news
  .filter((item) => item.visible)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

// Helfer zur Datumsformatierung
const formatNewsDate = (dateString: string): string => {
  const date = new Date(dateString);
  return date.toLocaleDateString("de-DE", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
};

// Eindeutige Jahre für die Filterung ermitteln
const years = [
  ...new Set(visibleNews.map((item) => new Date(item.date).getFullYear())),
].sort((a, b) => b - a);
---

<BaseLayout
  title="News - Aktuelles von Frickeldave"
  description="Aktuelle Neuigkeiten, Updates und Ankündigungen von Frickeldave. Neue Produkte, Blog-Artikel und mehr."
>
  <PageHeader title="News" colorScheme="red" />

  <!-- Mobile Filter Bar (visible only on small screens) -->
  <section class="section py-2 lg:hidden">
    <div class="container">
      <div class="glass space-y-4 rounded-lg p-4">
        <!-- Search Row -->
        <div class="flex gap-2">
          <input
            type="text"
            id="mobile-search-input"
            placeholder="Suche nach News..."
            class="flex-1 rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-sm placeholder-white/70 focus:border-blue-400 focus:outline-none"
          />
        </div>

        <!-- Year Filter Toggle -->
        <div class="flex gap-2">
          <button
            id="mobile-years-toggle"
            class="flex flex-1 items-center justify-between rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-sm transition-all duration-200 hover:bg-white/20"
          >
            <span>Jahr filtern</span>
            <svg
              class="h-4 w-4 transform transition-transform"
              id="mobile-years-arrow"
            >
              <path
                stroke="currentColor"
                stroke-width="2"
                d="M6 9l6 6 6-6"
                fill="none"></path>
            </svg>
          </button>
        </div>

        <!-- Years Dropdown (initially hidden) -->
        <div id="mobile-years-dropdown" class="hidden">
          <div class="grid grid-cols-3 gap-2">
            {
              years.map((year) => (
                <button
                  class="mobile-year-filter rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-center text-sm transition-all duration-200 hover:bg-white/20"
                  data-year={year}
                >
                  {year}
                </button>
              ))
            }
          </div>
        </div>

        <!-- Results Count and Clear Button -->
        <div
          class="flex items-center justify-between border-t border-white/20 pt-2"
        >
          <div id="mobile-results-count" class="text-sm opacity-70">
            {visibleNews.length} von {visibleNews.length} News
          </div>
          <button
            id="mobile-clear-filters"
            class="rounded border border-red-400/30 bg-red-500/20 px-3 py-1 text-sm transition-all duration-200 hover:bg-red-500/30"
          >
            Filter zurücksetzen
          </button>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container flex">
      <div class="row mx-0 w-full px-0">
        <!-- News Grid -->
        <div class="col-12 lg:col-8 lg:p-0">
          <div
            id="news-grid"
            class="mb-8 grid grid-cols-1 gap-6 md:grid-cols-2"
          >
            {
              visibleNews.map((item, _index) => {
                const imagePath = "/" + item.imageUrl;
                const imageModule = newsImages[imagePath];
                const image = imageModule
                  ? imageModule.default
                  : placeholderNewsImage;

                return (
                  <div
                    class="news-card"
                    data-title={item.title.toLowerCase()}
                    data-text={item.text.toLowerCase()}
                    data-date={item.date}
                    data-year={new Date(item.date).getFullYear()}
                  >
                    <article class="glass flex h-full flex-col overflow-hidden rounded-lg">
                      <div class="flex aspect-video w-full shrink-0 items-center justify-center px-2 pt-2">
                        <Image
                          src={image}
                          alt={item.title}
                          class="max-h-full max-w-full rounded-lg shadow-sm"
                          loading="lazy"
                        />
                      </div>
                      <div class="flex flex-grow flex-col p-6">
                        <div class="mb-3 flex items-center gap-2 text-sm text-red-500">
                          <FaRegCalendarAlt className="inline-block" />
                          <time datetime={item.date}>
                            {formatNewsDate(item.date)}
                          </time>
                        </div>
                        <h2 class="mb-3 text-xl font-bold text-red-600 dark:text-red-400">
                          {item.title}
                        </h2>
                        <p class="flex-grow text-base opacity-90">
                          {item.text}
                        </p>
                      </div>
                    </article>
                  </div>
                );
              })
            }
          </div>

          <!-- No Results Message -->
          <div
            id="no-results"
            class="glass hidden rounded-lg py-12 text-center"
          >
            <p class="text-xl opacity-70">
              Keine News gefunden. Versuche andere Filter.
            </p>
          </div>
        </div>

        <!-- Sidebar -->
        <div
          class="max-h-static_sidemenu sticky top-[4rem] hidden p-0 pl-4 lg:col-4 lg:flex"
        >
          <NewsSidebar years={years} totalNews={visibleNews.length} />
        </div>
      </div>
    </div>
  </section>

  <script>
    // Clientseitige Filterlogik für die News
    (() => {
      let selectedYear: number | null = null;
      let searchQuery = "";
      let isInitialized = false;

      // News-Karten holen (nach dem ersten Aufruf gecacht)
      function getNewsCards() {
        const newsGrid = document.getElementById("news-grid");
        return newsGrid ? newsGrid.querySelectorAll(".news-card") : [];
      }

      function filterAndSort() {
        const newsCards = getNewsCards();
        const totalNews = newsCards.length;
        let visibleCount = 0;

        newsCards.forEach((card) => {
          const cardElement = card as HTMLElement;
          const title = cardElement.dataset.title || "";
          const text = cardElement.dataset.text || "";
          const year = parseInt(cardElement.dataset.year || "0");

          // Suchbegriff prüfen
          const matchesSearch =
            searchQuery === "" ||
            title.includes(searchQuery.toLowerCase()) ||
            text.includes(searchQuery.toLowerCase());

          // Jahresfilter prüfen
          const matchesYear = selectedYear === null || year === selectedYear;

          if (matchesSearch && matchesYear) {
            cardElement.style.display = "";
            visibleCount++;
          } else {
            cardElement.style.display = "none";
          }
        });

        // Ergebniszähler aktualisieren (Desktop und Mobil)
        const countText = `${visibleCount} von ${totalNews} News`;
        const resultsCount = document.getElementById("results-count");
        const mobileResultsCount = document.getElementById(
          "mobile-results-count"
        );
        if (resultsCount) resultsCount.textContent = countText;
        if (mobileResultsCount) mobileResultsCount.textContent = countText;

        // „Keine Ergebnisse“-Meldung ein- bzw. ausblenden
        const noResults = document.getElementById("no-results");
        const newsGrid = document.getElementById("news-grid");
        if (noResults) {
          noResults.classList.toggle("hidden", visibleCount > 0);
        }
        if (newsGrid) {
          newsGrid.classList.toggle("hidden", visibleCount === 0);
        }
      }

      // Stile der Jahres-Buttons aktualisieren
      function updateYearButtonStyles() {
        document
          .querySelectorAll(".year-filter, .mobile-year-filter")
          .forEach((btn) => {
            const btnYear = parseInt((btn as HTMLElement).dataset.year || "0");
            if (selectedYear === btnYear) {
              btn.classList.add("bg-white/40", "border-white/60");
            } else {
              btn.classList.remove("bg-white/40", "border-white/60");
            }
          });
      }

      // Alle Filter zurücksetzen
      function clearAllFilters() {
        searchQuery = "";
        selectedYear = null;

        // Suchfelder leeren
        const searchInput = document.getElementById(
          "search-input"
        ) as HTMLInputElement;
        const mobileSearchInput = document.getElementById(
          "mobile-search-input"
        ) as HTMLInputElement;
        if (searchInput) searchInput.value = "";
        if (mobileSearchInput) mobileSearchInput.value = "";

        // Stile der Jahres-Buttons zurücksetzen
        updateYearButtonStyles();

        filterAndSort();
      }

      // Klick auf einen Jahres-Button behandeln
      function handleYearClick(target: HTMLElement) {
        const year = parseInt(target.dataset.year || "0");
        console.log(
          "Year button clicked:",
          year,
          "Current selectedYear:",
          selectedYear
        );

        if (selectedYear === year) {
          selectedYear = null;
        } else {
          selectedYear = year;
        }

        console.log("New selectedYear:", selectedYear);
        updateYearButtonStyles();
        filterAndSort();
      }

      // Eingabe im Suchfeld behandeln
      function handleSearchInput(value: string) {
        searchQuery = value;

        // Beide Suchfelder synchron halten
        const searchInput = document.getElementById(
          "search-input"
        ) as HTMLInputElement;
        const mobileSearchInput = document.getElementById(
          "mobile-search-input"
        ) as HTMLInputElement;
        if (searchInput && searchInput.value !== value)
          searchInput.value = value;
        if (mobileSearchInput && mobileSearchInput.value !== value)
          mobileSearchInput.value = value;

        filterAndSort();
      }

      function setupEventListeners() {
        if (isInitialized) return;
        isInitialized = true;

        console.log("Setting up news filter event listeners...");

        // Globaler Klick-Handler über Event-Delegation
        document.addEventListener("click", (e) => {
          const target = e.target as HTMLElement;

          // closest() nutzen, um den Button auch bei Klick auf ein Kindelement zu finden
          const yearButton = target.closest(
            ".year-filter, .mobile-year-filter"
          ) as HTMLElement;
          if (yearButton) {
            e.preventDefault();
            handleYearClick(yearButton);
            return;
          }

          // Auf den „Filter zurücksetzen“-Button prüfen
          const clearButton = target.closest(
            "#clear-filters, #mobile-clear-filters"
          );
          if (clearButton) {
            e.preventDefault();
            clearAllFilters();
            return;
          }
        });

        // Globaler Input-Handler für die Suchfelder
        document.addEventListener("input", (e) => {
          const target = e.target as HTMLInputElement;

          if (
            target.id === "search-input" ||
            target.id === "mobile-search-input"
          ) {
            handleSearchInput(target.value);
          }
        });

        // Mobile Jahres-Umschaltung
        document.addEventListener("click", (e) => {
          const target = e.target as HTMLElement;
          const toggle = target.closest("#mobile-years-toggle");
          if (toggle) {
            const dropdown = document.getElementById("mobile-years-dropdown");
            const arrow = document.getElementById("mobile-years-arrow");
            if (dropdown) dropdown.classList.toggle("hidden");
            if (arrow) arrow.classList.toggle("rotate-180");
          }
        });

        console.log("News filter event listeners set up successfully");
      }

      function initialize() {
        console.log("Initializing news filters...");
        setupEventListeners();
        filterAndSort();
        console.log("News filters initialized");
      }

      // Initialisieren, sobald das DOM bereit ist
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initialize);
      } else {
        initialize();
      }

      // filterAndSort bei Astro-Seitenübergängen erneut ausführen (Event-Listener bleiben erhalten)
      document.addEventListener("astro:page-load", () => {
        filterAndSort();
      });
    })();
  </script>
</BaseLayout>
