---
// Statischer Redirect-Handler für GitHub-Pages-Kompatibilität
// Nutzt clientseitiges JavaScript, um Redirects zu behandeln
import BaseLayout from "../../components/base/BaseLayout.astro";
---

<BaseLayout
  title="Weiterleitung - Frickeldave"
  description="Du wirst weitergeleitet..."
  robots="noindex, nofollow"
>
  <main class="container mx-auto px-4 py-8">
    <div class="mx-auto max-w-2xl">
      <!-- Loading State -->
      <div id="loading" class="glass glass-hover rounded-xl p-8 text-center">
        <div class="mb-6">
          <div
            class="mx-auto mb-4 h-12 w-12 animate-spin rounded-full border-4 border-blue-500 border-t-transparent"
          >
          </div>
          <h1 class="mb-2 text-3xl font-bold">Lade Weiterleitung...</h1>
          <p class="text-gray-600 dark:text-gray-300">Einen Moment bitte...</p>
        </div>
      </div>

      <!-- Content (will be populated by JavaScript) -->
      <div id="content" style="display: none;"></div>

      <!-- Error State -->
      <div
        id="error"
        class="glass glass-hover rounded-xl p-8 text-center"
        style="display: none;"
      >
        <div class="mb-6">
          <div class="mb-4 text-6xl text-red-500">⚠️</div>
          <h1 class="mb-2 text-3xl font-bold">Link nicht gefunden</h1>
          <p class="mb-6 text-gray-600 dark:text-gray-300">
            Der angeforderte Link konnte nicht gefunden werden.
          </p>
          <a
            href="/"
            class="inline-block rounded-lg bg-blue-600 px-6 py-3 font-medium text-white transition-colors hover:bg-blue-700"
          >
            Zurück zur Startseite
          </a>
        </div>
      </div>
    </div>
  </main>

  <!-- Client-side redirect handler -->
  <script is:inline>
    // Clientseitige Link-Verwaltung für GitHub-Pages-Kompatibilität
    let linkMappings = null;

    // Link-Zuordnungen aus statischem JSON initialisieren
    async function initializeLinkMappings() {
      try {
        const response = await fetch("/data/link-mappings.json");
        linkMappings = await response.json();
      } catch (error) {
        console.error("Failed to load link mappings:", error);
        linkMappings = {
          links: {},
          analytics: {
            totalClicks: 0,
            lastUpdated: new Date().toISOString().split("T")[0],
          },
        };
      }
    }

    // Link anhand der ID holen
    function getLinkById(id) {
      if (!linkMappings) {
        console.error("Link mappings not initialized");
        return null;
      }

      const link = linkMappings.links[id];
      if (!link) {
        return null;
      }

      // Alt-Links ohne openInNewTab-Eigenschaft behandeln
      return {
        ...link,
        openInNewTab: link.openInNewTab ?? true, // Default to true
      };
    }

    // Klickzahl erhöhen (clientseitiger Speicher)
    function incrementClickCount(id) {
      if (!linkMappings) {
        console.error("Link mappings not initialized");
        return;
      }

      if (!linkMappings.links[id]) {
        console.error("Link not found:", id);
        return;
      }

      // Aktuelle Zählerstände aus localStorage holen
      const stored = localStorage.getItem("linkClickCounts");
      const clickCounts = stored ? JSON.parse(stored) : {};

      // Zähler erhöhen
      clickCounts[id] = (clickCounts[id] || 0) + 1;

      // Zurück in localStorage schreiben
      localStorage.setItem("linkClickCounts", JSON.stringify(clickCounts));

      // Gesamtzahl der Klicks aktualisieren
      const totalClicks = Object.values(clickCounts).reduce(
        (sum, count) => sum + count,
        0
      );
      localStorage.setItem("totalLinkClicks", totalClicks.toString());
      localStorage.setItem(
        "lastLinkUpdate",
        new Date().toISOString().split("T")[0]
      );
    }

    async function loadLinkInfo() {
      const urlParams = new URLSearchParams(window.location.search);
      const id = urlParams.get("id");

      if (!id) {
        showError();
        return;
      }

      try {
        // Link-Zuordnungen initialisieren
        await initializeLinkMappings();

        // Link-Info aus statischen Daten holen
        const link = getLinkById(id);

        if (!link) {
          showError();
          return;
        }

        // Klickzahl erhöhen
        incrementClickCount(id);

        showLinkInfo(link);

        // Automatisch nach Verzögerung weiterleiten
        const redirectDelay = link.affiliate ? 3000 : 2000;
        setTimeout(() => {
          if (link.openInNewTab) {
            window.open(link.targetUrl, "_blank");
          } else {
            window.location.href = link.targetUrl;
          }
        }, redirectDelay);
      } catch (error) {
        console.error("Error loading link info:", error);
        showError();
      }
    }

    function showLinkInfo(link) {
      const loading = document.getElementById("loading");
      const content = document.getElementById("content");

      if (loading) loading.style.display = "none";
      if (content) {
        content.className = "glass glass-hover rounded-xl p-8 text-center";
        content.innerHTML = `
          <div class="mb-6">
            <h1 class="text-3xl font-bold mb-2">Weiterleitung</h1>
            <p class="text-gray-600 dark:text-gray-300">
              Du wirst in wenigen Sekunden weitergeleitet...
            </p>
          </div>

          <div class="bg-white/10 rounded-lg p-6 mb-6">
            <h2 class="text-xl font-semibold mb-2">${link.title}</h2>
            <p class="text-gray-600 dark:text-gray-300 mb-3">${link.description}</p>
            
            <div class="flex items-center justify-center gap-4 text-sm">
              <span class="px-3 py-1 bg-blue-500/20 text-blue-600 dark:text-blue-400 rounded-full">
                ${link.provider}
              </span>
              <span class="px-3 py-1 bg-gray-500/20 text-gray-600 dark:text-gray-400 rounded-full">
                ${link.category}
              </span>
            </div>
          </div>

          ${
            link.affiliate
              ? `
          <div class="bg-yellow-500/10 border border-yellow-500/20 rounded-lg p-4 mb-6">
            <p class="text-sm text-yellow-700 dark:text-yellow-300">
              <strong>Hinweis:</strong> Als Amazon-Partner verdiene ich an qualifizierten Verkäufen.
            </p>
          </div>
          `
              : ""
          }

          <div class="space-y-4">
            <a 
              href="${link.targetUrl}"
              class="inline-block px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors"
              rel="${link.affiliate ? "nofollow sponsored" : "nofollow"}"
              target="_blank"
            >
              Jetzt zu ${link.provider} →
            </a>
            
            <p class="text-xs text-gray-500">
              Oder warte, du wirst automatisch weitergeleitet.
            </p>
          </div>
        `;
        content.style.display = "block";
      }
    }

    function showError() {
      const loading = document.getElementById("loading");
      const error = document.getElementById("error");

      if (loading) loading.style.display = "none";
      if (error) error.style.display = "block";
    }

    // Link-Info beim Laden der Seite holen
    document.addEventListener("DOMContentLoaded", loadLinkInfo);
  </script>
</BaseLayout>

<style>
  /* Zusätzliche Stile für die Redirect-Seite */
  main {
    min-height: 70vh;
    display: flex;
    align-items: center;
  }
</style>
