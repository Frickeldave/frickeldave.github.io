---
import HandmadeLayout from "@components/handmade/HandmadeLayout.astro";
import ScadModelDisplay from "@components/handmade/ScadModelDisplay.astro";
---

<HandmadeLayout
  title="3D Druck - Frickeldave Handmade"
  description="Bald kannst du hier 3D-gedruckte Produkte nach deinen Wünschen konfigurieren."
>
  <div class="glass mb-8 rounded-lg p-8 text-center">
    <h2 class="mb-4 text-2xl font-bold">3D Druck</h2>
    <p class="text-txt-p dark:text-darkmode-txt-p">
      Hier entsteht bald eine Übersicht über individualisierbare
      3D-Druck-Produkte. Du wirst sie nach deinen Vorstellungen frei
      konfigurieren können.
    </p>
  </div>

  <ScadModelDisplay id="Verteilerdose" />
</HandmadeLayout>
