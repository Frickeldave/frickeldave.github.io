---
import HandmadeLayout from "@components/handmade/HandmadeLayout.astro";
---

<HandmadeLayout
  title="Tassen - Frickeldave Handmade"
  description="Bald kannst du hier Tassen nach deinen Wünschen konfigurieren."
>
  <div class="glass rounded-lg p-8 text-center">
    <h2 class="mb-4 text-2xl font-bold">Tassen</h2>
    <p class="text-txt-p dark:text-darkmode-txt-p">
      Hier entsteht bald eine Übersicht über individualisierbare Tassen. Du
      wirst sie nach deinen Vorstellungen frei konfigurieren können.
    </p>
  </div>
</HandmadeLayout>
