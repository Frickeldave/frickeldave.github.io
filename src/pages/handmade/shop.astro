---
import HandmadeLayout from "@components/handmade/HandmadeLayout.astro";
import Card from "@components/handmade/Card.astro";
import Sidebar from "@components/handmade/Sidebar.astro";
import type { HandmadeData } from "@/types";
import type { ImageMetadata } from "astro";
import { getHandmadeCategoryLabel } from "@/lib/handmadeCategoryLabels";

// Platzhalterbild importieren
import placeholderImage from "@/assets/placeholder-product-notfound.png";

// Handmade-Daten direkt importieren
import handmadeDataRaw from "../../../public/data/handmade.json";
const handmadeData = handmadeDataRaw as HandmadeData;

// Nur sichtbare Produkte filtern
const products = handmadeData.products.filter((p) => p.visible);

// Alle Bilder aus dem handmade-Ordner automatisch per Vite-Glob-Import laden
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/handmade/**/*.{png,jpg,jpeg,webp}",
  { eager: true }
);

// Zuordnung relativer Pfad → Bild anlegen
const imageMap = Object.entries(images).reduce(
  (acc, [path, image]) => {
    // Relativen Pfad aus dem vollständigen Pfad extrahieren (/src/assets/handmade/ entfernen)
    const relativePath = path.replace("/src/assets/handmade/", "");
    acc[relativePath] = image.default;
    return acc;
  },
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  {} as Record<string, any>
);

// Hilfsfunktion: Bild für ein Produkt ermitteln
// Hilfsfunktion: Bild für ein Produkt ermitteln
const getProductImage = (category: string, articleNumber: string) => {
  // Kategorie direkt als Ordnernamen nutzen
  const categoryFolder = category;
  // Dynamischer Lookup: jedes Bild finden, das zu diesem Produkt gehört
  const prefix = `${categoryFolder}/${articleNumber}/`;
  const matchingPath = Object.keys(imageMap).find((path) =>
    path.startsWith(prefix)
  );

  // Produktbild zurückgeben, falls vorhanden, sonst Platzhalter
  return matchingPath ? imageMap[matchingPath] : placeholderImage;
};

// Eindeutige Kategorien und Tags ermitteln
const categories = [...new Set(products.map((p) => p.category))];
const categoryLabels = categories.map(getHandmadeCategoryLabel);
const allTags = [...new Set(products.flatMap((p) => p.tags))].sort();
---

<HandmadeLayout
  title="Handmade - Unsere handgefertigten Produkte"
  description="Entdecke unsere handgefertigten Produkte aus Holz, 3D-Druck, Laser und Epoxidharz. Einzigartige Geschenke und Dekorationen."
>
  <Fragment slot="nav-extra">
    <div class="hidden lg:block">
      <Sidebar
        categories={categories}
        categoryLabels={categoryLabels}
        allTags={allTags}
        totalProducts={products.length}
      />
    </div>
  </Fragment>

  <!-- Mobile Filter Bar (visible only on small screens) -->
  <section class="section py-2 lg:hidden">
    <div class="container">
      <div class="glass space-y-4 rounded-lg p-4">
        <!-- Search and Sort Row -->
        <div class="flex gap-2">
          <input
            type="text"
            id="mobile-search-input"
            placeholder="Suche nach Name, Beschreibung oder Artikelnummer..."
            class="flex-1 rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-sm placeholder-white/70 focus:border-blue-400 focus:outline-none"
          />
          <select
            id="mobile-sort-select"
            class="rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-sm focus:border-blue-400 focus:outline-none"
          >
            <option value="name-asc">Name A-Z</option>
            <option value="name-desc">Name Z-A</option>
            <option value="price-asc">Preis ↑</option>
            <option value="price-desc">Preis ↓</option>
          </select>
        </div>

        <!-- Filter Toggles Row -->
        <div class="flex gap-2">
          <!-- Categories Toggle -->
          <button
            id="mobile-categories-toggle"
            class="flex flex-1 items-center justify-between rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-sm transition-all duration-200 hover:bg-white/20"
          >
            <span>Kategorien</span>
            <svg
              class="h-4 w-4 transform transition-transform"
              id="mobile-categories-arrow"
            >
              <path
                stroke="currentColor"
                stroke-width="2"
                d="M6 9l6 6 6-6"
                fill="none"></path>
            </svg>
          </button>

          <!-- Tags Toggle -->
          <button
            id="mobile-tags-toggle"
            class="flex flex-1 items-center justify-between rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-sm transition-all duration-200 hover:bg-white/20"
          >
            <span>Tags</span>
            <svg
              class="h-4 w-4 transform transition-transform"
              id="mobile-tags-arrow"
            >
              <path
                stroke="currentColor"
                stroke-width="2"
                d="M6 9l6 6 6-6"
                fill="none"></path>
            </svg>
          </button>

          <!-- Customizable Filter -->
          <label
            class="flex cursor-pointer items-center gap-2 rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-sm hover:bg-white/20"
          >
            <input
              type="checkbox"
              id="mobile-customizable-filter"
              class="h-4 w-4 rounded border-white/30"
            />
            <span class="text-sm">✨ Personalisierbar</span>
          </label>
        </div>

        <!-- Categories Dropdown (initially hidden) -->
        <div id="mobile-categories-dropdown" class="hidden">
          <div class="grid grid-cols-2 gap-2">
            {
              categories.map((category) => (
                <button
                  class="mobile-category-filter rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-left text-sm transition-all duration-200 hover:bg-white/20"
                  data-category={category}
                >
                  {getHandmadeCategoryLabel(category)}
                </button>
              ))
            }
          </div>
        </div>

        <!-- Tags Dropdown (initially hidden) -->
        <div id="mobile-tags-dropdown" class="hidden">
          <div class="grid max-h-40 grid-cols-2 gap-2 overflow-y-auto">
            {
              allTags.map((tag) => (
                <button
                  class="mobile-tag-filter rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-left text-sm transition-all duration-200 hover:bg-white/20"
                  data-tag={tag}
                >
                  {tag}
                </button>
              ))
            }
          </div>
        </div>

        <!-- Results Count and Clear Button -->
        <div
          class="flex items-center justify-between border-t border-white/20 pt-2"
        >
          <div id="mobile-results-count" class="text-sm opacity-70">
            {products.length} von {products.length} Produkten
          </div>
          <button
            id="mobile-clear-filters"
            class="rounded border border-red-400/30 bg-red-500/20 px-3 py-1 text-sm transition-all duration-200 hover:bg-red-500/30"
          >
            Filter zurücksetzen
          </button>
        </div>
      </div>
    </div>
  </section>

  <section class="section shop-products">
    <div class="container flex">
      <div class="row mx-0 w-full px-0">
        <!-- Products Grid -->
        <div class="col-12 lg:p-0">
          <!-- Products Grid -->
          <div
            id="products-grid"
            class="mb-8 grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3"
          >
            {
              products.map((product) => (
                <div
                  class="product-card"
                  data-article-number={product.articleNumber}
                  data-name={product.name.toLowerCase()}
                  data-description={product.description.toLowerCase()}
                  data-category={product.category}
                  data-tags={JSON.stringify(product.tags)}
                  data-price={product.price}
                  data-customizable={product.customizable}
                >
                  <Card
                    item={product}
                    image={getProductImage(
                      product.category,
                      product.articleNumber
                    )}
                  />
                </div>
              ))
            }
          </div>

          <!-- No Results Message -->
          <div
            id="no-results"
            class="glass hidden rounded-lg py-12 text-center"
          >
            <p class="text-xl opacity-70">
              Keine Produkte gefunden. Versuche andere Filter.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    // Skript bei jedem Seitenaufruf erneut ausführen
    (() => {
      // Clientseitige Filter- und Sortierlogik
      let selectedCategories: string[] = [];
      let selectedTags: string[] = [];
      let searchQuery = "";
      let sortBy = "name-asc";
      let filterCustomizable = false;

      function initializeFilters() {
        console.log("Initializing handmade filters...");

        // Desktop-Elemente
        const searchInput = document.getElementById(
          "search-input"
        ) as HTMLInputElement;
        const sortSelect = document.getElementById(
          "sort-select"
        ) as HTMLSelectElement;
        const customizableCheckbox = document.getElementById(
          "customizable-filter"
        ) as HTMLInputElement;
        const clearButton = document.getElementById("clear-filters");
        const productsGrid = document.getElementById("products-grid");
        const resultsCount = document.getElementById("results-count");
        const noResults = document.getElementById("no-results");
        const categoryButtons = document.querySelectorAll(".category-filter");
        const tagButtons = document.querySelectorAll(".tag-filter");

        // Mobile Elemente
        const mobileSearchInput = document.getElementById(
          "mobile-search-input"
        ) as HTMLInputElement;
        const mobileSortSelect = document.getElementById(
          "mobile-sort-select"
        ) as HTMLSelectElement;
        const mobileCustomizableCheckbox = document.getElementById(
          "mobile-customizable-filter"
        ) as HTMLInputElement;
        const mobileClearButton = document.getElementById(
          "mobile-clear-filters"
        );
        const mobileResultsCount = document.getElementById(
          "mobile-results-count"
        );
        const mobileCategoryButtons = document.querySelectorAll(
          ".mobile-category-filter"
        );
        const mobileTagButtons =
          document.querySelectorAll(".mobile-tag-filter");

        // Mobile Toggle-Elemente
        const mobileCategoriesToggle = document.getElementById(
          "mobile-categories-toggle"
        );
        const mobileTagsToggle = document.getElementById("mobile-tags-toggle");
        const mobileCategoriesDropdown = document.getElementById(
          "mobile-categories-dropdown"
        );
        const mobileTagsDropdown = document.getElementById(
          "mobile-tags-dropdown"
        );
        const mobileCategoriesArrow = document.getElementById(
          "mobile-categories-arrow"
        );
        const mobileTagsArrow = document.getElementById("mobile-tags-arrow");

        // Früh zurückkehren, wenn wesentliche Elemente fehlen
        if (!productsGrid || !noResults) {
          console.warn(
            "Essential handmade filter elements not found, retrying in 100ms..."
          );
          setTimeout(initializeFilters, 100);
          return;
        }

        function updateDisplay() {
          const productCards =
            productsGrid?.querySelectorAll(".product-card") || [];
          let visibleCount = 0;

          const sortedCards = Array.from(productCards).sort((a, b) => {
            const aPrice = parseFloat(a.getAttribute("data-price") || "0");
            const bPrice = parseFloat(b.getAttribute("data-price") || "0");
            const aName = a.getAttribute("data-name") || "";
            const bName = b.getAttribute("data-name") || "";

            switch (sortBy) {
              case "price-asc":
                return aPrice - bPrice;
              case "price-desc":
                return bPrice - aPrice;
              case "name-asc":
                return aName.localeCompare(bName);
              case "name-desc":
                return bName.localeCompare(aName);
              default:
                return 0;
            }
          });

          // Karten filtern und sortieren OHNE DOM-Manipulation, um Event-Listener zu erhalten
          sortedCards.forEach((card, index) => {
            const category = card.getAttribute("data-category") || "";
            const tags = JSON.parse(card.getAttribute("data-tags") || "[]");
            const name = card.getAttribute("data-name") || "";
            const description = card.getAttribute("data-description") || "";
            const articleNumber =
              card.getAttribute("data-article-number") || "";
            const customizable =
              card.getAttribute("data-customizable") === "true";

            let visible = true;

            // Nach Kategorien filtern (falls welche gewählt)
            if (
              selectedCategories.length > 0 &&
              !selectedCategories.includes(category)
            ) {
              visible = false;
            }

            // Nach Tags filtern (falls welche gewählt)
            if (
              selectedTags.length > 0 &&
              !selectedTags.every((tag) => tags.includes(tag))
            ) {
              visible = false;
            }

            // Nach „anpassbar“ filtern
            if (filterCustomizable && !customizable) {
              visible = false;
            }

            // Nach Suche filtern
            if (searchQuery) {
              const query = searchQuery.toLowerCase();
              if (
                !name.includes(query) &&
                !description.includes(query) &&
                !articleNumber.toLowerCase().includes(query) &&
                !tags.some((tag: string) => tag.toLowerCase().includes(query))
              ) {
                visible = false;
              }
            }

            if (visible) {
              visibleCount++;
              card.classList.remove("hidden");
            } else {
              card.classList.add("hidden");
            }

            // Sortierung über CSS-order statt DOM-Manipulation anwenden
            (card as HTMLElement).style.order = index.toString();
          });

          // Ergebniszähler aktualisieren (Desktop und Mobil)
          const totalCount = productCards.length;
          const resultsText = `${visibleCount} von ${totalCount} Produkten`;

          if (resultsCount) {
            resultsCount.textContent = resultsText;
          }
          if (mobileResultsCount) {
            mobileResultsCount.textContent = resultsText;
          }

          // „Keine Ergebnisse“-Meldung ein- bzw. ausblenden
          if (noResults) {
            if (visibleCount === 0) {
              noResults.classList.remove("hidden");
            } else {
              noResults.classList.add("hidden");
            }
          }
        }

        // Bestehende Event-Listener durch Klonen der Elemente entfernen
        const cleanupAndReattachEvents = () => {
          // Kategorie-Buttons klonen, um alle Event-Listener zu entfernen
          categoryButtons.forEach((button) => {
            const newButton = button.cloneNode(true);
            button.parentNode?.replaceChild(newButton, button);
          });

          // Tag-Buttons klonen, um alle Event-Listener zu entfernen
          tagButtons.forEach((button) => {
            const newButton = button.cloneNode(true);
            button.parentNode?.replaceChild(newButton, button);
          });

          // Auch die mobilen Buttons klonen
          mobileCategoryButtons.forEach((button) => {
            const newButton = button.cloneNode(true);
            button.parentNode?.replaceChild(newButton, button);
          });

          mobileTagButtons.forEach((button) => {
            const newButton = button.cloneNode(true);
            button.parentNode?.replaceChild(newButton, button);
          });

          // Mobile Toggle-Buttons klonen, um alle Event-Listener zu entfernen
          if (mobileCategoriesToggle) {
            const newToggle = mobileCategoriesToggle.cloneNode(true);
            mobileCategoriesToggle.parentNode?.replaceChild(
              newToggle,
              mobileCategoriesToggle
            );
          }

          if (mobileTagsToggle) {
            const newToggle = mobileTagsToggle.cloneNode(true);
            mobileTagsToggle.parentNode?.replaceChild(
              newToggle,
              mobileTagsToggle
            );
          }
        };

        // Bestehende Listener entfernen
        cleanupAndReattachEvents();

        // Nach dem Aufräumen alle Buttons neu abfragen
        const freshCategoryButtons =
          document.querySelectorAll(".category-filter");
        const freshTagButtons = document.querySelectorAll(".tag-filter");
        const freshMobileCategoryButtons = document.querySelectorAll(
          ".mobile-category-filter"
        );
        const freshMobileTagButtons =
          document.querySelectorAll(".mobile-tag-filter");

        // Mobile Toggle-Elemente nach dem Aufräumen neu abfragen
        const freshMobileCategoriesToggle = document.getElementById(
          "mobile-categories-toggle"
        );
        const freshMobileTagsToggle =
          document.getElementById("mobile-tags-toggle");

        // Kategorie-Filterbuttons mit Toggle-Funktion (inkl. mobilem Sync)
        freshCategoryButtons.forEach((button) => {
          button.addEventListener("click", () => {
            const category = button.getAttribute("data-category") || "";

            if (selectedCategories.includes(category)) {
              // Kategorie abwählen
              selectedCategories = selectedCategories.filter(
                (c) => c !== category
              );
              button.classList.remove("!bg-blue-500/30", "!border-blue-400");
            } else {
              // Kategorie auswählen
              selectedCategories.push(category);
              button.classList.add("!bg-blue-500/30", "!border-blue-400");
            }

            // Mit den mobilen Buttons über eine frische Query synchronisieren
            freshMobileCategoryButtons.forEach((mobileBtn) => {
              if (mobileBtn.getAttribute("data-category") === category) {
                if (selectedCategories.includes(category)) {
                  mobileBtn.classList.add(
                    "!bg-blue-500/30",
                    "!border-blue-400"
                  );
                } else {
                  mobileBtn.classList.remove(
                    "!bg-blue-500/30",
                    "!border-blue-400"
                  );
                }
              }
            });

            updateDisplay();
          });
        });

        // Tag-Filterbuttons mit Toggle-Funktion (inkl. mobilem Sync)
        freshTagButtons.forEach((button) => {
          button.addEventListener("click", () => {
            const tag = button.getAttribute("data-tag") || "";

            if (selectedTags.includes(tag)) {
              selectedTags = selectedTags.filter((t) => t !== tag);
              button.classList.remove("!bg-blue-500/30", "!border-blue-400");
            } else {
              selectedTags.push(tag);
              button.classList.add("!bg-blue-500/30", "!border-blue-400");
            }

            // Mit den mobilen Buttons über eine frische Query synchronisieren
            freshMobileTagButtons.forEach((mobileBtn) => {
              if (mobileBtn.getAttribute("data-tag") === tag) {
                if (selectedTags.includes(tag)) {
                  mobileBtn.classList.add(
                    "!bg-blue-500/30",
                    "!border-blue-400"
                  );
                } else {
                  mobileBtn.classList.remove(
                    "!bg-blue-500/30",
                    "!border-blue-400"
                  );
                }
              }
            });

            updateDisplay();
          });
        });

        // Suchfeld (inkl. mobilem Sync)
        searchInput?.addEventListener("input", (e) => {
          searchQuery = (e.target as HTMLInputElement).value;
          if (mobileSearchInput) mobileSearchInput.value = searchQuery;
          updateDisplay();
        });

        // Sortier-Auswahl (inkl. mobilem Sync)
        sortSelect?.addEventListener("change", (e) => {
          sortBy = (e.target as HTMLSelectElement).value;
          if (mobileSortSelect) mobileSortSelect.value = sortBy;
          updateDisplay();
        });

        // „Anpassbar“-Filter (inkl. mobilem Sync)
        customizableCheckbox?.addEventListener("change", (e) => {
          filterCustomizable = (e.target as HTMLInputElement).checked;
          if (mobileCustomizableCheckbox)
            mobileCustomizableCheckbox.checked = filterCustomizable;
          updateDisplay();
        });

        // Button „Filter zurücksetzen“
        clearButton?.addEventListener("click", () => {
          selectedCategories = [];
          selectedTags = [];
          searchQuery = "";
          sortBy = "name-asc";
          filterCustomizable = false;

          if (searchInput) searchInput.value = "";
          if (sortSelect) sortSelect.value = "name-asc";
          if (customizableCheckbox) customizableCheckbox.checked = false;

          // Kategorie-Buttons zurücksetzen
          document.querySelectorAll(".category-filter").forEach((btn) => {
            btn.classList.remove("!bg-blue-500/30", "!border-blue-400");
          });

          // Tag-Buttons zurücksetzen
          document.querySelectorAll(".tag-filter").forEach((btn) => {
            btn.classList.remove("!bg-blue-500/30", "!border-blue-400");
          });

          updateDisplay();
        });

        // ===============================
        // MOBILE FILTER-EVENT-LISTENER
        // ===============================

        // Mobile Toggle-Funktion (mit frischen Referenzen)
        freshMobileCategoriesToggle?.addEventListener("click", () => {
          console.log("Mobile categories toggle clicked");
          const isOpen =
            !mobileCategoriesDropdown?.classList.contains("hidden");
          if (isOpen) {
            mobileCategoriesDropdown?.classList.add("hidden");
            mobileCategoriesArrow?.classList.remove("rotate-180");
          } else {
            mobileCategoriesDropdown?.classList.remove("hidden");
            mobileCategoriesArrow?.classList.add("rotate-180");
          }
        });

        freshMobileTagsToggle?.addEventListener("click", () => {
          console.log("Mobile tags toggle clicked");
          const isOpen = !mobileTagsDropdown?.classList.contains("hidden");
          if (isOpen) {
            mobileTagsDropdown?.classList.add("hidden");
            mobileTagsArrow?.classList.remove("rotate-180");
          } else {
            mobileTagsDropdown?.classList.remove("hidden");
            mobileTagsArrow?.classList.add("rotate-180");
          }
        });

        // Mobile Kategorie-Filter
        freshMobileCategoryButtons.forEach((button) => {
          button.addEventListener("click", () => {
            const category = button.getAttribute("data-category") || "";

            if (selectedCategories.includes(category)) {
              selectedCategories = selectedCategories.filter(
                (c) => c !== category
              );
              button.classList.remove("!bg-blue-500/30", "!border-blue-400");
            } else {
              selectedCategories.push(category);
              button.classList.add("!bg-blue-500/30", "!border-blue-400");
            }

            // Mit den Desktop-Buttons über eine frische Query synchronisieren
            freshCategoryButtons.forEach((desktopBtn) => {
              if (desktopBtn.getAttribute("data-category") === category) {
                if (selectedCategories.includes(category)) {
                  desktopBtn.classList.add(
                    "!bg-blue-500/30",
                    "!border-blue-400"
                  );
                } else {
                  desktopBtn.classList.remove(
                    "!bg-blue-500/30",
                    "!border-blue-400"
                  );
                }
              }
            });

            updateDisplay();
          });
        });

        // Mobile Tag-Filter
        freshMobileTagButtons.forEach((button) => {
          button.addEventListener("click", () => {
            const tag = button.getAttribute("data-tag") || "";

            if (selectedTags.includes(tag)) {
              selectedTags = selectedTags.filter((t) => t !== tag);
              button.classList.remove("!bg-blue-500/30", "!border-blue-400");
            } else {
              selectedTags.push(tag);
              button.classList.add("!bg-blue-500/30", "!border-blue-400");
            }

            // Mit den Desktop-Buttons über eine frische Query synchronisieren
            freshTagButtons.forEach((desktopBtn) => {
              if (desktopBtn.getAttribute("data-tag") === tag) {
                if (selectedTags.includes(tag)) {
                  desktopBtn.classList.add(
                    "!bg-blue-500/30",
                    "!border-blue-400"
                  );
                } else {
                  desktopBtn.classList.remove(
                    "!bg-blue-500/30",
                    "!border-blue-400"
                  );
                }
              }
            });

            updateDisplay();
          });
        });

        // Mobiles Suchfeld
        mobileSearchInput?.addEventListener("input", (e) => {
          searchQuery = (e.target as HTMLInputElement).value;
          if (searchInput) searchInput.value = searchQuery; // Sync with desktop
          updateDisplay();
        });

        // Mobile Sortier-Auswahl
        mobileSortSelect?.addEventListener("change", (e) => {
          sortBy = (e.target as HTMLSelectElement).value;
          if (sortSelect) sortSelect.value = sortBy; // Sync with desktop
          updateDisplay();
        });

        // Mobiler „Anpassbar“-Filter
        mobileCustomizableCheckbox?.addEventListener("change", (e) => {
          filterCustomizable = (e.target as HTMLInputElement).checked;
          if (customizableCheckbox)
            customizableCheckbox.checked = filterCustomizable; // Sync with desktop
          updateDisplay();
        });

        // Mobiler Button „Filter zurücksetzen“
        mobileClearButton?.addEventListener("click", () => {
          selectedCategories = [];
          selectedTags = [];
          searchQuery = "";
          sortBy = "name-asc";
          filterCustomizable = false;

          // Mobile Eingaben zurücksetzen
          if (mobileSearchInput) mobileSearchInput.value = "";
          if (mobileSortSelect) mobileSortSelect.value = "name-asc";
          if (mobileCustomizableCheckbox)
            mobileCustomizableCheckbox.checked = false;

          // Desktop-Eingaben zurücksetzen
          if (searchInput) searchInput.value = "";
          if (sortSelect) sortSelect.value = "name-asc";
          if (customizableCheckbox) customizableCheckbox.checked = false;

          // Alle Filter-Buttons zurücksetzen
          document
            .querySelectorAll(".category-filter, .mobile-category-filter")
            .forEach((btn) => {
              btn.classList.remove("!bg-blue-500/30", "!border-blue-400");
            });

          document
            .querySelectorAll(".tag-filter, .mobile-tag-filter")
            .forEach((btn) => {
              btn.classList.remove("!bg-blue-500/30", "!border-blue-400");
            });

          // Mobile Dropdowns schließen
          mobileCategoriesDropdown?.classList.add("hidden");
          mobileTagsDropdown?.classList.add("hidden");
          mobileCategoriesArrow?.classList.remove("rotate-180");
          mobileTagsArrow?.classList.remove("rotate-180");

          updateDisplay();
        });

        // Erste Anzeige aktualisieren
        updateDisplay();
      }

      // Sofort initialisieren, wenn das DOM bereit ist
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initializeFilters);
      } else {
        // DOM ist bereits geladen
        setTimeout(initializeFilters, 0);
      }

      // Bei Astro-Seitenereignissen neu initialisieren
      document.addEventListener("astro:page-load", () => {
        console.log(
          "Astro page load event detected, reinitializing handmade filters..."
        );
        setTimeout(initializeFilters, 100);
      });

      document.addEventListener("astro:after-swap", () => {
        console.log(
          "Astro after-swap event detected, reinitializing handmade filters..."
        );
        setTimeout(initializeFilters, 100);
      });

      // Fallback für Navigationsereignisse
      window.addEventListener("popstate", () => {
        console.log(
          "Popstate event detected, reinitializing handmade filters..."
        );
        setTimeout(initializeFilters, 100);
      });

      // Ergänzende periodische Prüfung (alle 2 Sekunden, in den ersten 10 Sekunden)
      let checkCount = 0;
      const maxChecks = 5;
      const checkInterval = setInterval(() => {
        checkCount++;
        if (checkCount >= maxChecks) {
          clearInterval(checkInterval);
          return;
        }

        const hasButtons =
          document.querySelectorAll(".category-filter, .tag-filter").length > 0;
        if (!hasButtons) {
          console.log(
            `Backup check ${checkCount}/${maxChecks}: No filter buttons found, reinitializing...`
          );
          initializeFilters();
        }
      }, 2000);

      // Erster Aufruf
      initializeFilters();
    })();
  </script>
</HandmadeLayout>

<style>
  /*
   * Das Produktraster muss mit der ersten Box der Handmade-Sidebar („Bereiche“)
   * fluchten, aber `.section` fügt 3-4rem Top-Padding hinzu.
   *
   * Eine Tailwind-Utility kann das nicht aufheben: `utilities.scss` wird in
   * Tailwinds `utilities`-Layer *nach* den generierten Utilities geladen, damit
   * gewinnt `.section` gegen `pt-0` (verifiziert — `pt-0` lässt das Padding bei 64px).
   * Die zusätzliche Klasse erhöht stattdessen die Spezifität.
   */
  section.shop-products {
    padding-top: 0;
  }
</style>
