---
import type { BlogEntry } from "@/types";

interface Props {
  entry: BlogEntry;
}

const { entry } = Astro.props;
const ai = entry.data.aiTransparency;

const humanShare = ai?.humanShare ?? 0;
const aiShare = ai ? 100 - ai.humanShare : 0;

const scheme =
  humanShare > 70
    ? { name: "grün", human: "bg-green-500", ai: "bg-green-200" }
    : humanShare >= 30
      ? { name: "gelb", human: "bg-yellow-400", ai: "bg-yellow-200" }
      : { name: "rot", human: "bg-red-500", ai: "bg-red-200" };
---

{
  ai && (
    <div class="glass-t mt-8 rounded-lg p-3 text-sm">
      <h4 class="mb-1" style="margin: 0 0 0.25rem; line-height: 1.2">
        KI-Transparenz
      </h4>
      <div
        class="flex h-3 w-full overflow-hidden rounded"
        role="img"
        aria-label={`Anteile am Text: ${humanShare} Prozent menschlich, ${aiShare} Prozent KI-generiert, Farbschema ${scheme.name}`}
      >
        {humanShare > 0 && (
          <div
            class={`${scheme.human} ${
              aiShare > 0
                ? "dark:border-darkmode-bg-p border-r-2 border-white"
                : ""
            } h-full`}
            style={`width: ${humanShare}%`}
          />
        )}
        {aiShare > 0 && (
          <div class={`${scheme.ai} h-full`} style={`width: ${aiShare}%`} />
        )}
      </div>
      <p class="mt-1 mb-1" style="line-height: 1.4; font-size: 0.875rem">
        {humanShare} % menschlich · {aiShare} % KI-generiert
      </p>
      <table style="margin: 0.25rem 0 0; line-height: 1.4">
        <caption class="sr-only">
          Details zur KI-Transparenz dieses Artikels
        </caption>
        <tbody>
          <tr>
            <th scope="row" style="padding: 0.25rem 0.5rem">
              KI-generierter Anteil
            </th>
            <td style="padding: 0.25rem 0.5rem">{aiShare} %</td>
          </tr>
          <tr>
            <th scope="row" style="padding: 0.25rem 0.5rem">
              Bewertendes LLM
            </th>
            <td style="padding: 0.25rem 0.5rem">{ai.model}</td>
          </tr>
          <tr>
            <th scope="row" style="padding: 0.25rem 0.5rem">
              Konfidenz
            </th>
            <td style="padding: 0.25rem 0.5rem">{ai.confidence}</td>
          </tr>
          <tr>
            <td colspan="2" style="padding: 0.25rem 0.5rem">
              <div class="flex items-center gap-2">
                <a
                  href="/blog/ki-text-erkennung/"
                  style="text-decoration: none"
                  aria-label="So wird KI-Text erkannt"
                  title="So wird KI-Text erkannt"
                >
                  ℹ️
                </a>
                {ai.comment && (
                  <span style="line-height: 1.4; font-size: 0.875rem">
                    {ai.comment}
                  </span>
                )}
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  )
}
