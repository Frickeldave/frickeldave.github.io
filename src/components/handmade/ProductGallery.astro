---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  images: ImageMetadata[];
  productName: string;
}

const { images, productName } = Astro.props;

// Platzhalter nutzen, wenn keine Bilder vorhanden sind
import placeholderImage from "@/assets/placeholder-product-notfound.png";
const displayImages = images.length > 0 ? images : [placeholderImage];
---

<div class="product-gallery flex gap-6">
  <!-- Left Side: Mini Gallery (Thumbnails arranged vertically) -->
  <div class="mini-gallery flex-shrink-0">
    <div class="gallery-scroll flex flex-col space-y-2 overflow-y-auto">
      {
        displayImages.map((image, index) => (
          <button
            type="button"
            class="thumbnail-btn glass overflow-hidden rounded-md border-2 border-transparent transition-colors hover:border-blue-500 focus:border-blue-500"
            data-image-index={index}
          >
            <Image
              src={image}
              alt={`${productName} - Bild ${index + 1}`}
              class="thumbnail-image"
              loading="lazy"
            />
          </button>
        ))
      }
    </div>
  </div>

  <!-- Right Side: Main Image Display -->
  <div class="main-image-container flex-1">
    <div class="main-image-wrapper glass block overflow-hidden rounded-lg">
      <Image
        src={displayImages[0]}
        alt={`${productName} - Hauptbild`}
        id="main-image"
        class="h-80 w-full object-contain md:h-[520px]"
        loading="eager"
      />
    </div>
  </div>
</div>

<script>
  // Interaktionslogik der Galerie
  function initGallery() {
    const mainImage = document.getElementById("main-image") as HTMLImageElement;
    const thumbnailButtons = document.querySelectorAll(".thumbnail-btn");

    if (!mainImage || thumbnailButtons.length === 0) {
      return;
    }

    // Alle Bildquellen holen
    const imageSources = Array.from(thumbnailButtons).map((btn) => {
      const img = btn.querySelector("img") as HTMLImageElement;
      return {
        src: img.src,
        alt: img.alt,
      };
    });

    // Erstem Thumbnail den aktiven Zustand geben
    if (thumbnailButtons.length > 0) {
      thumbnailButtons[0].classList.add("border-blue-500");
    }

    // Funktion zur Bildumschaltung
    const changeImage = (index: number, btn: Element) => {
      // Aktiven Zustand von allen Thumbnails entfernen
      thumbnailButtons.forEach((b) => b.classList.remove("border-blue-500"));

      // Angeklicktem Thumbnail den aktiven Zustand geben
      btn.classList.add("border-blue-500");

      // Hauptbild mit Fade-Effekt aktualisieren
      const imageData = imageSources[index];
      mainImage.style.opacity = "0";

      setTimeout(() => {
        mainImage.src = imageData.src;
        mainImage.alt = imageData.alt;
        mainImage.style.opacity = "1";
      }, 150);
    };

    // Vorhandene Listener entfernen, bevor neue hinzugefügt werden
    thumbnailButtons.forEach((btn, index) => {
      const handleClick = (e: Event) => {
        e.preventDefault();
        changeImage(index, btn);
      };

      // Alten Listener entfernen, falls vorhanden
      (btn as HTMLElement).onclick = null;

      // Neuen Listener hinzufügen
      btn.addEventListener("click", handleClick);
    });
  }

  // Beim Laden initialisieren
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initGallery);
  } else {
    initGallery();
  }

  // Bei Astro-Seitenübergängen neu initialisieren
  document.addEventListener("astro:page-load", initGallery);
</script>

<style>
  @reference "../../styles/tailwind.css";
  .product-gallery {
    @apply w-full overflow-hidden;
  }

  .mini-gallery {
    @apply flex-shrink-0;
    width: 5rem; /* w-20 equivalent - 80px */
  }

  @media (min-width: 768px) {
    .mini-gallery {
      width: 6rem; /* w-24 equivalent - 96px */
    }
  }

  .gallery-scroll {
    height: 20rem; /* h-80 equivalent - same as main image */
    @apply overflow-y-auto;
    /* Scrollbars verstecken, Funktion aber erhalten */
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* Internet Explorer 10+ */
  }

  /* Scrollbars für WebKit-Browser ausblenden (Chrome, Safari, Edge) */
  .gallery-scroll::-webkit-scrollbar {
    display: none;
  }

  @media (min-width: 768px) {
    .gallery-scroll {
      height: 32.5rem; /* 520px equivalent for md screens - same as main image */
    }
  }

  .main-image-container {
    @apply relative;
  }

  .main-image-wrapper {
    @apply w-full;
  }

  .main-image-container img {
    transition: opacity 150ms ease-in-out;
  }

  #main-image {
    @apply h-80 w-full object-contain;
  }

  @media (min-width: 768px) {
    #main-image {
      height: 32.5rem; /* 520px */
    }
  }

  .thumbnail-btn {
    @apply cursor-pointer transition-all duration-200;
    width: 5rem; /* 80px */
    height: 5rem; /* 80px */
    flex-shrink: 0;
  }

  @media (min-width: 768px) {
    .thumbnail-btn {
      width: 6rem; /* 96px */
      height: 6rem; /* 96px */
    }
  }

  .thumbnail-image {
    @apply h-full w-full object-cover;
  }

  .thumbnail-btn:hover {
    @apply scale-105 transform;
  }

  .thumbnail-btn:focus {
    @apply ring-2 ring-blue-500 ring-offset-2 outline-none;
  }
</style>
