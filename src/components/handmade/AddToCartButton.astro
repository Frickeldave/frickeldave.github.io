---
import type { HandmadeItem } from "@/types";

interface Props {
  item: Pick<HandmadeItem, "articleNumber" | "name">;
  /** `card` rendert einen kompakten Button für Produktraster, `detail` ein größeres CTA. */
  variant?: "card" | "detail";
}

const { item, variant = "detail" } = Astro.props;

const isCard = variant === "card";

// Der Karten-Button teilt sich die Zeile mit dem Preis in den schmalen
// `xl`-Rasterspalten (~213px Platz), deshalb trägt er das kürzere Label. Das Label
// ändert sich nie: die Bestätigung tauscht stattdessen das Icon, was die Breite
// stabil hält und ein Umbrechen der Zeile verhindert.
const label = isCard ? "Hinzufügen" : "In den Warenkorb";

const buttonClasses = [
  "inline-flex items-center justify-center gap-1.5 rounded-md",
  "bg-gradient-to-r from-cyan-500 to-teal-500 font-medium text-white",
  "transition-all duration-300 hover:from-cyan-600 hover:to-teal-600",
  "focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500",
  "focus-visible:ring-offset-2 dark:focus-visible:ring-offset-gray-900",
  isCard
    ? "flex-shrink-0 px-2.5 py-2 text-xs whitespace-nowrap"
    : "w-full px-4 py-3 text-sm",
].join(" ");
---

<div class="add-to-cart">
  <button
    type="button"
    class={buttonClasses}
    data-add-to-cart
    data-article-number={item.articleNumber}
    data-product-name={item.name}
    data-quantity="1"
    aria-label={`${item.name} in den Warenkorb legen`}
  >
    <svg
      class="h-4 w-4 flex-shrink-0"
      data-add-to-cart-icon="cart"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"
      ></path>
    </svg>
    <svg
      class="hidden h-4 w-4 flex-shrink-0"
      data-add-to-cart-icon="done"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M4.5 12.75l6 6 9-13.5"></path>
    </svg>
    <span data-add-to-cart-label>{label}</span>
  </button>
  <span class="sr-only" role="status" data-add-to-cart-status></span>
</div>

<style>
  /*
   * Bestätigungszustand, gesteuert über `data-state` statt über getauschte
   * Tailwind-Klassen: konkurrierende `from-*`/`to-*`-Utilities würden über die
   * Stylesheet-Reihenfolge aufgelöst, nicht über ihre Reihenfolge im class-Attribut.
   */
  .add-to-cart button[data-state="added"] {
    background-image: linear-gradient(
      to right,
      var(--color-green-500, #22c55e),
      var(--color-emerald-500, #10b981)
    );
  }
</style>

<script>
  import { bindCartDom } from "../../lib/cart-dom";

  bindCartDom();
</script>
