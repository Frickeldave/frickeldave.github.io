---
import type { AboutMeEntry, BlogEntry } from "@/types";
import { getEntries } from "@lib/contentParser";
import HandmadeGrid from "./HandmadeGrid";

interface Props {
  entry: AboutMeEntry;
}

const { entry } = Astro.props;
const { handmadeProjects = [] } = entry.data;

// Alle Blog-Posts holen, um weitere DIY-/Holzwerken-Projekte zu finden
const allBlogPosts = await getEntries("blog");
const blogProjects = allBlogPosts
  .filter((post) => {
    const data = (post as BlogEntry).data;
    return (
      data.categories?.includes("DIY") ||
      data.categories?.includes("Holzwerken")
    );
  })
  .map((post) => {
    const data = (post as BlogEntry).data;
    return {
      title: data.title,
      description: data.description || "",
      image: data.image,
      blogUrl: `/blog/${post.id}`,
      category: data.categories?.includes("Holzwerken") ? "Holzwerken" : "DIY",
    };
  });

// Statische Projekte aus aboutme/index und dynamische Projekte aus dem Blog zusammenführen
// Map nutzen, um Duplikate über Titel oder blogUrl zu vermeiden
const projectMap = new Map();

// Zuerst die Blog-Projekte ergänzen (meist aktueller)
blogProjects.forEach((p) => projectMap.set(p.blogUrl, p));
// Dann die statischen Projekte ergänzen (überschreiben oder neu hinzufügen)
handmadeProjects.forEach((p) => projectMap.set(p.blogUrl, p));

const combinedProjects = Array.from(projectMap.values());
---

{
  combinedProjects.length > 0 && (
    <div class="row justify-center">
      <div class="col-12">
        <div class="glass rounded-2xl p-6 lg:p-10">
          {/* Section Header */}
          <div class="mb-8 text-center">
            <h2 class="text-txt-h dark:text-darkmode-txt-h mb-3 text-2xl font-bold lg:text-3xl">
              🛠️ Handmade Portfolio
            </h2>
            <p class="text-txt-p dark:text-darkmode-txt-p mx-auto max-w-2xl opacity-80">
              Hier siehst du eine zufällige Auswahl meiner DIY- und
              Holzwerken-Projekte. Klicke auf "Neue Auswahl zeigen", um weitere
              Projekte zu entdecken.
            </p>
          </div>

          <HandmadeGrid projects={combinedProjects} client:load />
        </div>
      </div>
    </div>
  )
}
