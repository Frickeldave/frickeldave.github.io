---
import ThemeSwitcher from "@components/base/ThemeSwitcher.astro";
import { CART_PAGE_PATH } from "../../lib/cart";
import { IoCartOutline, IoSearch } from "react-icons/io5";

const { pathname } = Astro.url;

const stickyHeader = true;

const menu = [
  {
    name: "Home",
    url: "/",
  },
  {
    name: "Docs",
    url: "/docs",
  },
  {
    name: "Blog",
    url: "/blog",
  },
  // {
  //   name: "Recipes",
  //   url: "/recipes",
  // },
  {
    name: "Downloads",
    url: "/downloads",
  },
  // {
  //   name: "Index Cards",
  //   url: "/index-cards",
  // },
  // {
  //   name: "Author",
  //   url: "/author",
  // },
  {
    name: "About Me",
    url: "/aboutme",
  },
  {
    name: "Handmade",
    url: "/handmade/shop",
  },
  {
    name: "News",
    url: "/news",
  },
];
---

<header
  transition:persist
  class={`container glass py-2 z-30 mb-4 lg:mt-4 lg:rounded-lg ${stickyHeader && "sticky top-0"}`}
>
  <nav class="relative flex flex-wrap items-center justify-between">
    <!-- navbar toggler -->
    <input id="nav-toggle" type="checkbox" class="hidden" />
    <label
      for="nav-toggle"
      class="text-txt-p dark:text-darkmode-txt-p order-0 flex cursor-pointer items-center md:hidden lg:order-1"
    >
      <svg id="show-button" class="block h-6 fill-current" viewBox="0 0 20 20">
        <title>Menu Open</title>
        <path d="M0 3h20v2H0V3z m0 6h20v2H0V9z m0 6h20v2H0V0z"></path>
      </svg>
      <svg id="hide-button" class="hidden h-6 fill-current" viewBox="0 0 20 20">
        <title>Menu Close</title>
        <polygon
          points="11 9 22 9 22 11 11 11 11 22 9 22 9 11 -2 11 -2 9 9 9 9 -2 11 -2"
          transform="rotate(45 10 10)"></polygon>
      </svg>
    </label>
    <!-- /navbar toggler -->
    <ul
      id="nav-menu"
      class="order-3 hidden w-full pb-6 text-center md:order-1 md:flex md:w-auto md:space-x-2 md:pb-0 lg:space-x-4 lg:text-left"
    >
      {
        menu.map((item) => (
          <li class="">
            <a
              href={item.url}
              class={`font-secondary text-txt-p dark:text-darkmode-txt-p block p-2 font-semibold transition lg:px-2 lg:py-3 ${
                (pathname === `${item.url}/` || pathname === item.url) &&
                "active"
              }`}
            >
              {item.name}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="order-1 ml-auto flex items-center md:order-2 lg:ml-0">
      {
        /*
        Cart shortcut. Deliberately carries no display utility: it is toggled
        with the `hidden` attribute, which a `flex`/`inline-flex` class would
        override. The icon box inside handles the layout instead.
      */
      }
      <a
        href={CART_PAGE_PATH}
        data-cart-link
        data-cart-hide-when-empty
        data-cart-link-label="Zum Warenkorb"
        aria-label="Zum Warenkorb"
        class="border-border text-txt-p dark:border-darkmode-border dark:text-darkmode-txt-p relative mr-4 text-xl"
        hidden
      >
        <span class="inline-flex items-center">
          <IoCartOutline />
          <span
            class="absolute -top-1 -right-1.5 min-w-4 rounded-full bg-cyan-600 px-1 text-center text-[0.625rem] leading-4 font-semibold text-white"
            data-cart-count
            hidden>0</span
          >
        </span>
      </a>
      <a
        class="border-border text-txt-p dark:border-darkmode-border dark:text-darkmode-txt-p mr-4 inline-block text-xl"
        href="/search"
        aria-label="search"
      >
        <IoSearch />
      </a>
      <ThemeSwitcher />
    </div>
  </nav>
</header>

<script>
  // The header ships on every page, so it owns the cart DOM binding: the
  // counter, the reveal-on-non-empty behaviour and the add-to-cart clicks.
  import { bindCartDom } from "../../lib/cart-dom";

  bindCartDom();
</script>
