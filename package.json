{
  "name": "Astrogon",
  "version": "1.0.0",
  "description": "Template.",
  "author": "Frickeldave",
  "license": "MIT",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "postbuild": "pagefind --site dist",
    "prepare": "husky",
    "postinstall": "npm run prose-install && npm run install-gh-copilot",
    "install-gh-copilot": "node scripts/install-gh-copilot.mjs",
    "format": "prettier --write ./src --log-level silent",
    "format:check": "prettier --check ./src",
    "lint": "eslint ./src --fix",
    "lint:check": "eslint ./src",
    "prose-install": "node scripts/prose-install.mjs",
    "prose": "node scripts/prose-check.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.0",
    "@astrojs/react": "^6.0.0",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "astro": "^7.0.3",
    "astro-tooltips": "^0.6.2",
    "clsx": "^2.1.1",
    "date-fns": "^2.30.0",
    "date-fns-tz": "^2.0.0",
    "fuse.js": "^6.6.2",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.21",
    "marked": "^6.0.0",
    "mermaid": "^11.16.0",
    "prop-types": "^15.8.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.5.0",
    "react-lite-youtube-embed": "^2.3.52",
    "rehype-katex": "^7.0.1",
    "remark-collapse": "^0.1.2",
    "remark-math": "^6.0.0",
    "remark-toc": "^8.0.1",
    "sharp": "^0.32.4",
    "swiper": "^12.1.3",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.2",
    "@types/marked": "^5.0.1",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "astro-eslint-parser": "^2.1.0",
    "autoprefixer": "^10.5.2",
    "eslint": "^10.6.0",
    "eslint-plugin-astro": "^2.1.1",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "pagefind": "^1.0.4",
    "postcss": "^8.5.16",
    "prettier": "^3.9.4",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "sass": "^1.101.0",
    "tailwind-bootstrap-grid": "^7.0.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1"
  },
  "overrides": {
    "undici": "^7.19.0"
  }
}
